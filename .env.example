# ARCA · Configuración. Copie este archivo como .env (nunca versione el .env).

# local | test | staging | produccion
ARCA_ENTORNO=local

# SQLite para probar en local; PostgreSQL en servidor:
# ARCA_DATABASE_URL=postgresql+psycopg://arca:cambie_esta_clave@localhost:5432/arca
ARCA_DATABASE_URL=sqlite:///./arca_local.db

# OBLIGATORIAS fuera de local: dos llaves largas, distintas y propias.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ARCA_CLAVE_SECRETA=
ARCA_CLAVE_SELLADO=

ARCA_MINUTOS_SESION=120
ARCA_ORIGENES_PERMITIDOS=["http://localhost:3000"]
