# GEOLOGY · Configuración
# Copie este archivo como .env  (en Windows:  copy .env.example .env)
# Docker Compose lo lee tanto para los contenedores como para las variables de la plantilla.
# NUNCA comparta ni versione el archivo .env: contiene llaves.

# --- PostgreSQL -------------------------------------------------------------
PG_USUARIO=geology
PG_CLAVE=cambie_esta_clave
PG_BASE=geology
# Puerto de PostgreSQL hacia el equipo anfitrión. Va en 5433 para no chocar con otra
# plataforma que ya use el 5432 en el mismo servidor.
PG_PUERTO=5433

# Cadena de conexión que usa la aplicación.
# Dentro de Docker el servidor se llama "almacen_datos"; fuera de Docker use localhost.
DATABASE_URL=postgresql+psycopg2://geology:cambie_esta_clave@almacen_datos:5432/geology

# --- Redis y trabajos en segundo plano --------------------------------------
CELERY_BROKER_URL=redis://mensajeria:6379/0
CELERY_RESULT_BACKEND=redis://mensajeria:6379/1
GEOLOGY_COLA=geology

# --- Seguridad. OBLIGATORIO antes de publicar en la red ----------------------
# Llave con la que se firman las sesiones. Invente una larga y no la comparta.
# Si la deja vacía, las sesiones se caen cada vez que el servidor reinicia.
GEOLOGY_CLAVE=cambie_esta_llave_por_una_larga_y_propia
GEOLOGY_HORAS_SESION=12

# --- Aplicación -------------------------------------------------------------
# Puerto de la interfaz. Si otra plataforma ya usa el 8080, cámbielo (por ejemplo 8090).
PUERTO_WEB=8080
# desarrollo publica la documentación interactiva en /docs; produccion la cierra.
GEOLOGY_ENTORNO=desarrollo
ORIGENES_PERMITIDOS=http://localhost:8080
ZONA_HORARIA=America/Bogota

# --- Almacenamiento de objetos (opcional) -------------------------------------
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
URL_PREFIRMADA_SEGUNDOS=900

# --- Lectores (modelos de lenguaje) -------------------------------------------
# Sin estas llaves el levantamiento automático de hojas de control no funciona.
# Escríbalas seguidas del signo igual, sin comillas y sin espacios. Con una alcanza para
# empezar; cada una que agregue es más capacidad diaria.
#
#   ANTHROPIC_API_KEY  https://console.anthropic.com      empieza por sk-ant-
#   GEMINI_API_KEY     https://aistudio.google.com/apikey  empieza por AIza
#   OPENAI_API_KEY     https://platform.openai.com/api-keys empieza por sk-
#
# Se pueden poner varias del mismo proveedor: separadas por comas en un renglón, o
# numeradas una por renglón (GEMINI_API_KEY_1, GEMINI_API_KEY_2, ... hasta 30).
# Después de escribirlas:  docker compose up -d --force-recreate servidor procesador
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=

# Modelos a usar de cada proveedor (vacío = se le pregunta al proveedor y se usan todos).
MODELOS_CLAUDE=
MODELOS_GEMINI=
MODELOS_OPENAI=
# Modelos que NO quiere usar, separados por comas.
EXCLUIR_MODELOS=
# Cada cuántas horas se vuelve a preguntar la lista de modelos.
HORAS_CATALOGO=6

# Techo diario de llamadas por cada modelo de ese proveedor.
CUOTA_CLAUDE=1000
CUOTA_GEMINI=500
CUOTA_OPENAI=500

# Reparto por tamaño: de este número de folios en adelante va a los modelos de más aliento.
UMBRAL_FOLIOS=100

# --- Levantamiento de hojas de control ----------------------------------------
# El levantamiento arranca solo al cargar la carpeta (no = pulsar el botón a mano).
LEVANTAR_AL_CARGAR=si
# Segundos que espera antes de empezar a leer, para que lleguen todas las partes de un
# expediente fraccionado (_1, _2, _3...) y se lean juntas y en orden.
SEGUNDOS_ANTES_DE_LEER=45
# Cuántos expedientes se procesan al mismo tiempo (póngalo igual al número de llaves).
TRABAJADORES_EN_PARALELO=6
# Techo de minutos por trabajo del procesador.
TECHO_MINUTOS_POR_TAREA=150

# --- Recepción técnica de lo digitalizado --------------------------------------
# Mínimo de puntos por pulgada exigido. En CERO no se exige ninguno (material de trabajo).
UMBRAL_DPI=0
IDIOMA_OCR=spa
SEGUNDOS_PROCESO_IMAGEN=1800

# --- Lectura de documentos extensos -------------------------------------------
# Peso y páginas máximas por petición al lector. Un archivo mayor se lee por bloques en
# memoria; el archivo del depósito no se toca.
TOPE_MB_POR_ARCHIVO=30
TOPE_PAGINAS_POR_ARCHIVO=100
# Copia liviana para el lector (resolución a la que se reduce; el depósito no se toca).
ALIGERAR_PARA_EL_MODELO=1
DPI_PARA_EL_MODELO=150
SEGUNDOS_ALIGERAR=900

# --- División automática de documentos de gran volumen ------------------------
# Un archivo que se cargue entero con más páginas que este tope (por ejemplo un libro de
# 1.000 imágenes) se divide solo en partes consecutivas (_1, _2, _3...) dentro del depósito,
# conservando el orden de las imágenes. En CERO no se divide.
PAGINAS_POR_PARTE=250
