# ARCA · Configuración del servidor. Copie a «.env» (nunca lo versione) y complete.
# Genere cada secreto con:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# La llave del almacén con: python3 -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"

ARCA_DOMINIO=arca.ejemplo.com
ARCA_ENTORNO=produccion
ARCA_URL_PUBLICA=https://arca.ejemplo.com
ARCA_ORIGENES_PERMITIDOS=["https://arca.ejemplo.com"]

# Base de datos
POSTGRES_USER=arca
POSTGRES_PASSWORD=
POSTGRES_DB=arca

# Secretos (obligatorios, distintos entre sí)
ARCA_CLAVE_SECRETA=
ARCA_CLAVE_SELLADO=

# Cifrado de los archivos (obligatorio en producción). GUÁRDELA FUERA DEL SERVIDOR: sin ella no se pueden leer los archivos.
ARCA_CLAVE_CIFRADO_ALMACEN=
# ARCA_CLAVES_CIFRADO_ANTERIORES=["llave-anterior"]

# Almacenamiento: «local» (volumen del servidor) o «s3» (nube o MinIO)
ARCA_ALMACEN_PROVEEDOR=s3
ARCA_S3_BUCKET=arca-archivos
# ARCA_S3_ENDPOINT=http://minio:9000   # con el perfil «minio»; vacío para AWS
ARCA_S3_REGION=us-east-1
ARCA_S3_CIFRADO_SERVIDOR=AES256
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Correo saliente (invitaciones y recuperación de contraseña)
ARCA_SMTP_HOST=
ARCA_SMTP_PUERTO=587
ARCA_SMTP_USUARIO=
ARCA_SMTP_CLAVE=
ARCA_SMTP_REMITENTE=ARCA <no-responder@ejemplo.com>

# Capacidad
ARCA_WORKERS_API=2
ARCA_TRABAJADORES=2
ARCA_PAGINAS_OCR_POR_TANDA=30
